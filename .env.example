# ==============================================================================
# FloodLens AI - Environment Configuration Example
# Copy this file to .env and populate your credentials.
# NEVER commit .env to source control!
# ==============================================================================

# Application Execution Mode
# Set to 'true' to use verified offline/demonstration fixtures labeled DEMO DATA
# Set to 'false' to execute live Copernicus CDSE and OpenStreetMap queries
DEMO_MODE=true

# Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Copernicus Data Space Ecosystem (CDSE) Credentials
# Register at: https://dataspace.copernicus.eu/
# Required for real-data Sentinel-1 GRD, Sentinel-2 MSI, and DEM downloads
CDSE_USERNAME=your_copernicus_username_here
CDSE_PASSWORD=your_copernicus_password_here
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# OpenStreetMap Configuration
# The challenge specifies 2026-07-27 as the pre-event baseline snapshot reference
OSM_SNAPSHOT_DATE=2026-07-27
OSM_OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
OSM_DIRECT_API_ENDPOINT=https://api.openstreetmap.org/api/0.6

# AI Situation Report LLM Configuration (Optional Grounded Summarizer)
# If no key is provided, a deterministic grounded template summarizer is used.
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=gemini

# Primary Study Area Reference: Trishuli Corridor, Bagmati / Gandaki Province, Nepal
# Default AOI Bounding Box: [Min Lon, Min Lat, Max Lon, Max Lat]
DEFAULT_AOI_BBOX=85.05,27.75,85.25,27.95
DEFAULT_EVENT_DATE=2026-08-04
